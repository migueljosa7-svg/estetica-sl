# Copia este archivo a `.env` y ajusta los valores.
# En Vite solo se exponen al frontend las variables con prefijo VITE_.
# NUNCA subas claves privadas, tokens ni secretos reales al frontend.

# URL pública del sitio (usada en sitemap, canonical y metadatos).
VITE_SITE_URL=https://estetica-guion.vercel.app

# Habilita el acceso de DEMO al panel /admin (admin / admin).
# - En `npm run dev` el acceso demo está activado por defecto.
# - En producción se desactiva salvo que esta variable sea "true".
# ADVERTENCIA: es una barrera cosmética de demostración, NO autenticación real.
VITE_ENABLE_DEMO_ADMIN=false
